{% extends "mapping_page_template.html.twig" %}
{% set domain_level = "subject" %}

{% block domain_level %}
<h1>Subject-Level Domain Mappings</h1>
<p>For each of the subject-level domains you selected, you will need to add one or more mappings from the data collection instruments that capture the data that falls into that domain. Your data collection instruments may collect variables for a single copy of that instrument that need to end up as multiple rows in the SDTM data, these will require separate output rows in your mappings. You may also want to conditionally limit the data that is included in the SDTM, for example whether or not a value was entered or if a leading question indicates that a test was performed, for these you will need to enter the inclusion logic for the output row.</p>
{% endblock domain_level %}

{% block mapping_preview %}
<script>
  function previewMapping() {

      $(".result-preview").remove();

      const module = ExternalModules.Vanderbilt.REDSTAMP.ExternalModule;

      const payload = {
          "record_id": 1,
          "domain_filter": "{{ sdtm_domain['name'] }}"
      };

      console.log(payload);

      module.ajax('apply_mapping', payload).then(function(response) {
          // Process response
          console.log("response");
          console.log(response);
          doIt(JSON.parse(response));
          return response;
      }).catch(function(err) {
          console.log(err);
          // Handle error
      });
  }

  function doIt(response) {
      console.log(response);
      for (const [k, v] of Object.entries(response)) {
          
          const uid = v['uid'];
          const result = v['result'];
          const input_element = $(`#input_${uid}`)

          input_element.after(`<div id="preview_${uid}" class="form-text text-muted result-preview">Result: ${result}</div>`);

          $(`#preview_${uid}`).effect("highlight", {}, 1500);
      }
  }
</script>
<button onclick="previewMapping()">Preview Mapping for {{ sdtm_domain['name'] }}</button>
{% endblock mapping_preview %}
