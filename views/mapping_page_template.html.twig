<title>KCKCKC Template map page title</title>
{% block domain_level %}
{% endblock %}

<!-- TODO: replace yucky inline script, hacky retention -->
<script>
  function mergeParamsWithForm(event) {
    const form = event.target;
    // Get current URL parameters
    const urlParams = new URLSearchParams(window.location.search);
		const dont_carry = ["domain_filter", "redcap_csrf_token"];

    // Add each parameter as a hidden input field
    for (const [key, value] of urlParams.entries()) {
			if (dont_carry.includes(key)) continue;
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = key;
      hiddenInput.value = value;
      form.appendChild(hiddenInput);
    }
  }
</script>

<form  method="GET" onsubmit="mergeParamsWithForm(event)"">
  <label for="domain_filter">Select domain:</label>
	<!-- NOTE: onsubmit in form does not fire with onchange -->
	<select name="domain_filter" id="domain_filter" onchange="mergeParamsWithForm(event); this.form.submit();">
		{% for domain in sdtm_domains %}
			<option
				value="{{ domain.name }}"
				{% if domain.name == get.domain_filter %}
				selected disabled
				{% endif %}
			>
				{{  domain.name }} - {{ domain.label }}
			</option>
		{% endfor %}
	</select>
	<!-- <button type="submit">Apply Domain Filter</button> -->
</form>

<div id='factor_tbl'>
</div>

