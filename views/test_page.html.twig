<!-- TODO: add these attrs back once this issue is resolved: https://github.com/wenzhixin/bootstrap-table/issues/7719 -->
<!-- data-icons-prefix="fa"
     data-icons="icons" -->

<table
  id="table"
  class="table table-striped table-responsive table-hover"

  data-show-columns="true"
  data-icons-prefix="fa"

  data-filter-control="true"
  data-visible-search="true"
  data-show-filter-control-switch="true"
  data-sort-select-options="true"
  data-hide-unused-select-options="true"

  data-show-search-clear-button="true"

  >
  <thead class="sticky-header" data-sticky-header=true>
    <tr>
      <!-- autopopulate from csv -->
      {% for k, v in sdtm|first %}
        {% if k not in skip_cols %}
          {% if k in filter_cols %}
            <th
              scope="col"
              data-filter-control="select"
              data-filter-strict-search="true"
              data-field="{{k|lower|replace({' ': '-'})}}"
            >
              {{k}}
            </th>
          {% else %}
            <th scope="col">{{k}}</th>
          {% endif %}
        {% endif %}
      {% endfor %}

      <!-- add rc specific fields -->
      <th scope="col">Mapping group</th>

    </tr>
  </thead>
  <tbody class="table-group-divider">
    {% set domains = ["VS"] %}

    {% for row in sdtm %}
      {#% if row["Dataset Name"] in domains %#}
      {% if 1 == 1 %}
				{% set uid = row['Dataset Name'] ~ '.' ~ row['Variable Name'] %}
      <tr id="{{uid}}" class="req-{{row['Core']}} map_row">
        {% for k, v in row %}
          {% if k not in skip_cols %}
          {#% if k not in skip_cols and v['Dataset Name'] == "LB"%#}
              <td>
                {% if k in truncate_cols %}
                  {% set full_text = v %}
                  {% set truncated_text = v|striptags|slice(0, 50) %}

                  {% if full_text|length == truncated_text|length %}
                    {{ v }}
                  {% else %}

                    <div class="text-container">
                      <span class="truncated">{{ truncated_text }}</span><span class="ellipsis">...</span>
                      <span class="full-text" style="display: none;">{{ full_text|raw }}</span>
                      <a href="#" class="toggle-link" data-target="full-text">Read more</a>
                    </div>
                  {% endif %}
            {% else %}
              {{v}}
            {% endif %}
              </td>
          {% endif %}
        {% endfor %}

        <td>
          <button type="button" class="btn btn-sm btn-secondary map_thing_button">map</button>
					<!-- <input class="calc_text_input" style="display: none;" value="{{current_mappings[uid]}}"> -->
					<input class="calc_text_input" id="input_{{uid}}" style="" value="{{current_mappings[uid]['calc_text']}}">
        </td>
      </tr>
      {% endif %}
    {% endfor %}


  </tbody>
</table>

