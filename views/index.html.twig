</div>

<div id="status-update-alert-template" class="status-update alert" role="alert" style="display: none;">
</div>

{#% for i in range(1, 3) %#}

  <!-- <label for="input_{{i}}">Field {{i}} of {{imax}} mapped?</label> -->
  <!-- <label for="d_input_{{i}}_left">rc field {{i}}</label> -->
  <!-- <select name="d_input_{{i}}_left" id="input_{{i}}_left" class="select_box_left" value="" /> -->

  <!-- <p> test? </p> -->

  <!-- <p>{{ i }} </p> -->

  <!-- <label for="d_input_{{i}}_right">SDTM for {{i}}</label>
       <select name="d_input_{{i}}_right" id="input_{{i}}_right" class="select_box_right" value="" /> -->
<!-- </br> -->

{#% endfor %#}

{% set fields = getFields() %}

{% for idx, field in fields %}

  {#{ field }#}

  <!-- checkboxes for completion -->
  {#% set i = field['label'] %#}
  <!-- <label for="input_{{i}}">Field {{i}} of {{imax}} mapped?</label> -->
  <!-- <input type="checkbox" name="input_{{i}}" id="input_{{i}}" class="prog_cbox" value="" /> -->
  <!-- </br> -->
  <!-- end checkboxes for completion -->

  {#% for i in field %#}
    {#{i}#}
  {#% endfor %#}

{% endfor %}

<!-- table with mappings -->
<table class="table table-striped table-responsive table-hover">
  <thead class="sticky-header">
    <tr>
      <!-- <th scope="col">field number</th> -->
      <th scope="col">REDCap field name</th>
      <th scope="col">REDCap field label</th>
      <th scope="col">REDCap field required</th>
      <th scope="col">Choices</th>
      <th scope="col">Transformation</th>
      <th scope="col">Destination Variable</th>
      <th scope="col">Controls</th>
    </tr>
  </thead>
  <tbody class="table-group-divider">
{% for idx, field in fields %}
  <tr>
    <!-- <th scope="row">{{idx}}</th> -->
    <td>{{field['field_name']}}</td>
    <td>{{field['element_label']}}</td>
    <td>{{field['required'] ? "yes": "no"}}</td>
    {% if field['choices'] %}
      <td colspan="1">
        <table class="table mb-0">
          <thead>
            <th scope="col">Choices</th>
          </thead>
          <tbody>
            {% for choice in field['choices'] %}
              <tr>
                <td>{{choice}}</td>
              <tr>
            {% endfor %}
          </tbody>
        </table>
      </td>
    {% else %}
      <td>
      </td>
    {% endif %}
    <!-- Transformation -->
    <td>
      TODO
    </td>
    <!-- Destination -->
    <td>
      <select id="select_{{field_name}}" class="select2">
        <option value="">Select</option>
        <option value="1">1</option>
        <option value="2">2</option>
        <option value="3">3</option>
      </select>
    </td>
    <!-- Controls -->
    <td>
      <button type="button" class="btn btn-danger btn-sm">Delete</button>
    </td>
  </tr>


{% endfor %}

  </tbody>

{#% set imax = 3 %#}

{#% for i in range(1, imax) %#}

  <!-- <label for="input_{{i}}">Sample field {{i}} of {{imax}} mapped?</label> -->
  <!-- <input type="checkbox" name="input_{{i}}" id="input_{{i}}" class="prog_cbox" value="" /> -->
  <!-- </br> -->

{#% endfor %#}



{#% endblock %#}
