<div class="progress-stacked">
  {% set map_types_progress = ['Req', 'Exp', 'Perm'] %}
  {% for type in map_types_progress %}
    
    |
    <!-- TODO: center this above bar -->
    <span style="text-align: center; vertical-align: middle;"> {{type}} </span>
    <div class="progress" role="progressbar" aria-label="progress {{type}}" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width: 33%">
      <div class="progress-bar progress-bar-animated progress-bar-striped" id="mapping-progress-bar-{{type}}" style="width: 0%"></div>
    </div>
  {% endfor %}

</div>

