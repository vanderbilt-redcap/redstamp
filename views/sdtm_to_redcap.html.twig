<script>
  function mergeParamsWithForm(event) {
    const form = event.target;
    // Get current URL parameters
    const urlParams = new URLSearchParams(window.location.search);
		const dont_carry = ["domain_filter", "redcap_csrf_token"];

    // Add each parameter as a hidden input field
    for (const [key, value] of urlParams.entries()) {
			if (dont_carry.includes(key)) continue;
      const hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = key;
      hiddenInput.value = value;
      form.appendChild(hiddenInput);
    }
  }
</script>
<form  method="GET" onsubmit="mergeParamsWithForm(event)"">
  <label for="domain_filter">Domain Filter</label>
	<select name="domain_filter" id="domain_filter">
		{% for domain in sdtm_domains %}
			<option
				value="{{domain}}"
				{% if domain == get.domain_filter %}
				selected disabled
				{% endif %}
			>
				{{domain}}
			</option>
		{% endfor %}
	</select>
	<button type="submit">Apply Domain Filter</button>
</form>

