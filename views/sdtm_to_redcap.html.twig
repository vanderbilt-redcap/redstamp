<table
	id="table"
	class="table table-striped table-responsive table-hover"

	data-show-columns="true"
	data-icons-prefix="fa"

	data-filter-control="true"
	data-visible-search="true"
	data-show-filter-control-switch="true"
	data-sort-select-options="true"
	data-hide-unused-select-options="true"

	data-show-search-clear-button="true"

	style="table-layout: auto; width: fit-content; border-collapse: collapse;"
>
	<thead class="sticky-header">
		<tr>
			<!-- autopopulate from csv -->
			{% for k, v in sdtm|first %}
				{% if k in exposed_cols %}
					{% if k in filter_cols %}
						<th
							scope="col"
							data-filter-control="select"
							data-filter-strict-search="true"
							data-field="{{k|lower|replace({' ': '-'})}}"
						>
							{{k}}
						</th>
					{% else %}
						<th scope="col">{{k}}</th>
					{% endif %}
				{% endif %}
			{% endfor %}

			<!-- add rc specific fields -->
			{% for i in 0..max_instance %}
				<th scope="col">
					Output row
					<button type="button" class="btn btn-secondary add-output-row">
						<!-- FIXME: Can't use bi due to my hack to force fa icons lol -->
						<!-- <i class="bi bi-plus-lg"></i> -->
						+
					</button>
				</th>
			{% endfor %}
		</tr>
	</thead>

	<tbody class="table-group-divider">
		<tr id="{{uid}}" class="req-{{row['Core']}} map_row">
			<td></td>
			<td></td>
			<td></td>
			<td>Criteria input here</td>
		</tr>
		{% for row in sdtm %}
			{#% if row["Dataset Name"] in domains %#}
			{% set uid = row['Dataset Name'] ~ '__' ~ row['Variable Name'] %}
			<tr id="{{uid}}" class="req-{{row['Core']}} map_row">
				{% for k, v in row %}
					{% if k in exposed_cols %}
						<td> {{v}} </td>
					{% endif %}
				{% endfor %}
				<!-- Add info -->
				{% block info_content %}
				<!-- FIXME: remove if stable -->
					{% if false %}
				<div style="display: none;" hidden id="info_{{uid}}">
					{{ row['CDISC Notes'] }}
					{% set this_ctr_code = row['CDISC CT Codelist Code(s)'] %}
					{% if this_ctr_code != "" %}
						{#% set this_ctr = sdtm_ctr|filter((v, k) => v == this_ctr_code) %#}
						{% set this_ctr = sdtm_ctr|filter(row => this_ctr_code == row['Code']) %}
						<!-- TODO: nested table so it doesn't render on main -->
						<!-- <table class="table mb-0">
								 <thead>
								 <tr>
								 <th>k</th>
								 <th>v</th>
								 </tr>
								 </thead>
								 <tbody> -->
						{% for k, v in this_ctr|first %}
							{% if v != "" %}
								{{ k }}: {{ v }}
							{% endif %}
						{% endfor %}
						<!-- </tbody> -->
						<!-- </table> -->
					{% endif %}
				</div>
				{% endif %}
				{% endblock %}

				<!-- add mapping output rows -->
				{% for i in 0..max_instance %}
					{#% if i > 0 %#}
					{% set uid_i = uid ~ '__' ~ i %}
					{#% endif %#}
					<td>
						<!-- <button type="button" class="btn btn-sm btn-secondary map_thing_button">map</button> -->
						<!-- <input class="calc_text_input" style="display: none;" value="{{current_mappings[uid]}}"> -->
						<input class="calc_text_input col_instance_{{i}}" id="input_{{uid_i}}" name="input_{{uid_i}}" style="" value="{{current_mappings[uid_i]['calc_text']}}"
							onblur="logicHideSearchTip(this)"
							onfocus="openLogicEditor($(this))"
							onkeydown="logicSuggestSearchTip($(this), null, false, true, 0)"
						>

						<!-- HACK: element needed for logicSuggestTip -->
						<div id="LSC_id_input_{{uid_i}}" class="fs-item fs-item-parent" style="display: none;"></div>
					</td>
				{% endfor %}
			</tr>
		{% endfor %}


	</tbody>
</table>

